# ================================================================
# AI Channel App - PromptServ Starter Template
# ================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local

# ─── Keycloak OIDC (server-side only) ───
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=promptserv
KEYCLOAK_CLIENT_ID=promptserv-chat
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# ─── Auth BFF ───
AUTH_REDIRECT_URI=http://localhost:3009/api/auth/callback
AUTH_COOKIE_SECRET=change-me-to-random-32-char-string
# AUTH_MOCK=true  # Uncomment to bypass Keycloak for offline development

# ─── AI Gateway (Channel + JWT Mode) ───
# CHANNEL_API_KEY is the API key bound to your Channel in AI Gateway.
# Create a Channel → get the key → paste here.
# When set, the app uses Channel+JWT mode (recommended).
# When not set, falls back to Portal mode.
AI_GATEWAY_URL=http://localhost:4000
CHANNEL_API_KEY=your-channel-api-key-here

# ─── Set by the platform at deploy (ps-app-publisher) ───
# A deployed app never needs these in a file: the platform creates the app's
# channel and database login and passes them in the container environment.
# Fill them in .env.local only for local development.
#
# CHANNEL_API_KEY  - key of the app's own channel (see above)
# AI_GATEWAY_URL   - where the AI Gateway answers (see above)
# PORTAL_API_URL   - platform API, used by ADK (lib/adk.ts) and the channel check
# DATABASE_URL     - the app's own PostgreSQL login and schema (lib/db.ts)
# PS_APP_SLUG / PS_APP_URL / PS_APP_OWNER / PS_APP_TENANT - who and where this app is
PORTAL_API_URL=http://localhost:8080
DATABASE_URL=postgres://app_local:app_local@localhost:5432/ps_apps

# ─── Channel Permission Check (optional) ───
# When CHANNEL_ID is set, the app verifies the user has access to this
# channel via portal-service at login time. Users without access see a 403.
# CHANNEL_ID=your-channel-uuid-here

# ─── ALE Brain (Phase 5.1.1+) ───
# /api/ale/[...path] is auto-wired in app/api/ale/[...path]/route.ts.
# It reads the Keycloak JWT from the encrypted ps-token cookie (same
# AUTH_COOKIE_SECRET above) and forwards to AI_GATEWAY_URL/v1/ale/*.
# No additional env vars required - the gateway scopes responses to the
# user_id extracted from the JWT sub claim.

# Realm role gate enforced by RequireAuth - comma-separated, OR semantics.
# User must have at least one of these realm roles. Empty disables gating.
AUTH_REQUIRED_ROLES=User
